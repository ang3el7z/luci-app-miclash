#!/bin/sh

SAMPLE_INTERVAL_SEC=60
PRESSURE_SAMPLES_REQUIRED=5
WARMUP_SEC=900
BASELINE_SAMPLES_REQUIRED=6
MIN_RESERVE_KB=16384
MAX_RESERVE_KB=65536
MIN_GROWTH_KB=16384
SUCCESS_MIN_DROP_KB=8192
SUCCESS_COOLDOWN_SEC=21600
FAILURE_COOLDOWN_SEC=86400
REARM_NORMAL_SEC=1800
ACTION_BUSY_EXIT=75
PACKAGE_REMOVAL_BARRIER="/var/run/miclash/package-removal"

SETTINGS_FILE="${MICLASH_SETTINGS_FILE:-/opt/clash/settings}"
STATE_DIR="${MICLASH_MEMORY_GUARD_STATE_DIR:-/tmp/miclash-memory-guard}"
STATUS_FILE="$STATE_DIR/status"
BASELINE_SAMPLES_FILE="$STATE_DIR/baseline.samples"
PROC_ROOT="${MICLASH_PROC_ROOT:-/proc}"
SERVICE_BIN="${MICLASH_SERVICE_BIN:-/opt/clash/bin/miclash-service}"
SERVICE_INIT="${MICLASH_SERVICE_INIT:-/etc/init.d/miclash-memory-guard}"
MANUAL_OPERATION_FILE="/tmp/miclash-service/manual-operation"
LOGGER_TAG="miclash-memory-guard"
MUTATION_LOCK_HELD=0
MUTATION_LOCK_HELPER="/usr/share/miclash/mutation-lock.sh"
[ -r "$MUTATION_LOCK_HELPER" ] || { echo 'MiClash mutation lock unavailable' >&2; exit 1; }
. "$MUTATION_LOCK_HELPER" || exit 1

miclash_writer_lock_enter() {
	miclash_mutation_lock_enter normal 30000 || return $?
	MUTATION_LOCK_HELD=1
}

miclash_writer_lock_leave() {
	[ "$MUTATION_LOCK_HELD" = 1 ] || return 0
	miclash_mutation_lock_leave || return 1
	MUTATION_LOCK_HELD=0
}

trap 'miclash_writer_lock_leave >/dev/null 2>&1 || true' EXIT
trap 'exit 1' HUP INT TERM

PHASE="starting"
TRACKED_PID=""
TRACKED_STARTTIME=""
BASELINE_STARTED_AT=0
BASELINE_RSS=0
CURRENT_RSS=0
MEM_TOTAL=0
MEM_AVAILABLE=0
RESERVE=0
PSI_FULL_AVG10="unavailable"
PRESSURE_COUNT=0
LAST_ACTION="none"
LAST_RESULT="none"
COOLDOWN_UNTIL=0
NORMAL_SINCE=0
LAST_MANUAL_OPERATION=""

calc_reserve_kb() {
	value=$(($1 / 10))
	[ "$value" -lt "$MIN_RESERVE_KB" ] && value="$MIN_RESERVE_KB"
	[ "$value" -gt "$MAX_RESERVE_KB" ] && value="$MAX_RESERVE_KB"
	printf '%s\n' "$value"
}

is_anomaly() {
	baseline="$1"
	current="$2"
	[ "$baseline" -gt 0 ] || return 1
	[ "$current" -ge $((baseline + MIN_GROWTH_KB)) ] || return 1
	[ $((current * 100)) -ge $((baseline * 150)) ]
}

memory_decreased() {
	before="$1"
	after="$2"
	drop=$((before - after))
	[ "$drop" -ge "$SUCCESS_MIN_DROP_KB" ] || return 1
	[ $((drop * 100)) -ge $((before * 10)) ]
}

median_six() {
	printf '%s\n' "$@" | sort -n | awk 'NR == 3 { a = $1 } NR == 4 { print int((a + $1) / 2) }'
}

now_sec() {
	date +%s 2>/dev/null || echo 0
}

guard_log() {
	logger -p daemon.info -t "$LOGGER_TAG" "$*"
}

setting_enabled() {
	grep -q '^ENABLE_MEMORY_GUARD=true$' "$SETTINGS_FILE" 2>/dev/null
}

find_mihomo_pid() {
	pidof clash 2>/dev/null | awk '{ print $1 }'
}

read_process_starttime() {
	pid="$1"
	awk '{ print $22 }' "$PROC_ROOT/$pid/stat" 2>/dev/null
}

read_mihomo_rss_kb() {
	pid="$1"
	awk '/^VmRSS:/ { print $2; exit }' "$PROC_ROOT/$pid/status" 2>/dev/null
}

read_memory_metrics() {
	MEM_TOTAL="$(awk '/^MemTotal:/ { print $2; exit }' "$PROC_ROOT/meminfo" 2>/dev/null)"
	MEM_AVAILABLE="$(awk '/^MemAvailable:/ { print $2; exit }' "$PROC_ROOT/meminfo" 2>/dev/null)"
	case "$MEM_TOTAL" in ''|*[!0-9]*) return 1 ;; esac
	case "$MEM_AVAILABLE" in ''|*[!0-9]*) return 1 ;; esac
	RESERVE="$(calc_reserve_kb "$MEM_TOTAL")"
	return 0
}

read_memory_psi() {
	PSI_FULL_AVG10="unavailable"
	[ -r "$PROC_ROOT/pressure/memory" ] || return 0
	PSI_FULL_AVG10="$(awk '/^full / { for (i = 1; i <= NF; i++) if ($i ~ /^avg10=/) { sub(/^avg10=/, "", $i); print $i; exit } }' "$PROC_ROOT/pressure/memory" 2>/dev/null)"
	[ -n "$PSI_FULL_AVG10" ] || PSI_FULL_AVG10="unavailable"
}

print_snapshot() {
	read_memory_metrics || return 1
	read_memory_psi
	printf 'mem_total_kb=%s\n' "$MEM_TOTAL"
	printf 'mem_available_kb=%s\n' "$MEM_AVAILABLE"
	printf 'reserve_kb=%s\n' "$RESERVE"
	printf 'psi_full_avg10=%s\n' "$PSI_FULL_AVG10"
}

write_status() {
	mkdir -p "$STATE_DIR" 2>/dev/null || return 1
	tmp="$STATUS_FILE.tmp.$$"
	{
		printf 'phase=%s\n' "$PHASE"
		printf 'pid=%s\n' "$TRACKED_PID"
		printf 'baseline_rss_kb=%s\n' "$BASELINE_RSS"
		printf 'current_rss_kb=%s\n' "$CURRENT_RSS"
		printf 'mem_available_kb=%s\n' "$MEM_AVAILABLE"
		printf 'reserve_kb=%s\n' "$RESERVE"
		printf 'psi_full_avg10=%s\n' "$PSI_FULL_AVG10"
		printf 'pressure_samples=%s\n' "$PRESSURE_COUNT"
		printf 'last_action=%s\n' "$LAST_ACTION"
		printf 'last_result=%s\n' "$LAST_RESULT"
		printf 'cooldown_until=%s\n' "$COOLDOWN_UNTIL"
		printf 'updated_at=%s\n' "$(now_sec)"
	} > "$tmp" && mv "$tmp" "$STATUS_FILE"
}

status_value() {
	key="$1"
	[ -f "$STATUS_FILE" ] || return 0
	sed -n "s/^${key}=//p" "$STATUS_FILE" 2>/dev/null | tail -n 1
}

load_runtime_state() {
	saved_cooldown="$(status_value cooldown_until)"
	saved_result="$(status_value last_result)"
	case "$saved_cooldown" in ''|*[!0-9]*) saved_cooldown=0 ;; esac
	COOLDOWN_UNTIL="$saved_cooldown"
	case "$saved_result" in
		success|failed) LAST_RESULT="$saved_result" ;;
	esac
}

reset_baseline() {
	TRACKED_PID="$1"
	TRACKED_STARTTIME="$(read_process_starttime "$TRACKED_PID")"
	BASELINE_STARTED_AT="$(now_sec)"
	BASELINE_RSS=0
	CURRENT_RSS=0
	PRESSURE_COUNT=0
	rm -f "$BASELINE_SAMPLES_FILE" 2>/dev/null || true
	PHASE="warming_up"
	guard_log "tracking pid=$TRACKED_PID; baseline warm-up started"
}

read_manual_operation() {
	[ -f "$MANUAL_OPERATION_FILE" ] || return 0
	cat "$MANUAL_OPERATION_FILE" 2>/dev/null
}

detect_manual_operation() {
	generation="$(read_manual_operation)"
	[ -n "$generation" ] || return 1
	if [ -z "$LAST_MANUAL_OPERATION" ]; then
		LAST_MANUAL_OPERATION="$generation"
		return 1
	fi
	[ "$generation" != "$LAST_MANUAL_OPERATION" ] || return 1
	LAST_MANUAL_OPERATION="$generation"
	reset_baseline "$TRACKED_PID"
	guard_log "baseline reset after manual MiClash service operation: generation=$generation"
	return 0
}

collect_baseline_sample() {
	mkdir -p "$STATE_DIR" 2>/dev/null || return 1
	printf '%s\n' "$CURRENT_RSS" >> "$BASELINE_SAMPLES_FILE"
	count="$(wc -l < "$BASELINE_SAMPLES_FILE" | tr -d ' ')"
	[ "$count" -ge "$BASELINE_SAMPLES_REQUIRED" ] || return 1
	BASELINE_RSS="$(sort -n "$BASELINE_SAMPLES_FILE" | awk 'NR == 3 { a = $1 } NR == 4 { print int((a + $1) / 2); exit }')"
	PHASE="monitoring"
	guard_log "baseline learned: pid=$TRACKED_PID baseline_rss_kb=$BASELINE_RSS"
	return 0
}

cooldown_active() {
	now="$(now_sec)"
	[ "$COOLDOWN_UNTIL" -gt "$now" ]
}

failure_rearm_ready() {
	[ "$LAST_RESULT" = "failed" ] || return 0
	now="$(now_sec)"
	[ "$now" -ge "$COOLDOWN_UNTIL" ] || return 1
	if [ "$MEM_AVAILABLE" -ge "$RESERVE" ]; then
		if [ "$NORMAL_SINCE" -eq 0 ]; then
			NORMAL_SINCE="$now"
			return 1
		fi
		if [ $((now - NORMAL_SINCE)) -ge "$REARM_NORMAL_SEC" ]; then
			LAST_RESULT="rearmed"
			NORMAL_SINCE=0
			return 0
		fi
	else
		NORMAL_SINCE=0
	fi
	return 1
}

observe_pressure() {
	if is_anomaly "$BASELINE_RSS" "$CURRENT_RSS" && [ "$MEM_AVAILABLE" -lt "$RESERVE" ]; then
		PRESSURE_COUNT=$((PRESSURE_COUNT + 1))
	else
		PRESSURE_COUNT=0
	fi
}

handle_recovery_trigger() {
	[ ! -e "$PACKAGE_REMOVAL_BARRIER" ] || return "$ACTION_BUSY_EXIT"
	guard_log "recovery trigger: pid=$TRACKED_PID baseline_rss_kb=$BASELINE_RSS current_rss_kb=$CURRENT_RSS mem_available_kb=$MEM_AVAILABLE reserve_kb=$RESERVE psi_full_avg10=$PSI_FULL_AVG10"
	recover_memory
}

refresh_measurements() {
	pid="$(find_mihomo_pid)"
	[ -n "$pid" ] || return 1
	rss="$(read_mihomo_rss_kb "$pid")"
	case "$rss" in ''|*[!0-9]*) return 1 ;; esac
	TRACKED_PID="$pid"
	TRACKED_STARTTIME="$(read_process_starttime "$pid")"
	CURRENT_RSS="$rss"
	read_memory_metrics || return 1
	read_memory_psi
}

finish_recovery_success() {
	action="$1"
	recovered_rss="$CURRENT_RSS"
	now="$(now_sec)"
	COOLDOWN_UNTIL=$((now + SUCCESS_COOLDOWN_SEC))
	LAST_ACTION="$action"
	LAST_RESULT="success"
	reset_baseline "$TRACKED_PID"
	CURRENT_RSS="$recovered_rss"
	PHASE="cooldown"
	guard_log "recovery succeeded: action=$action current_rss_kb=$CURRENT_RSS mem_available_kb=$MEM_AVAILABLE cooldown_until=$COOLDOWN_UNTIL"
	write_status
}

finish_recovery_failure() {
	reason="$1"
	now="$(now_sec)"
	COOLDOWN_UNTIL=$((now + FAILURE_COOLDOWN_SEC))
	LAST_RESULT="failed"
	PHASE="failure_cooldown"
	guard_log "recovery failed: reason=$reason current_rss_kb=$CURRENT_RSS mem_available_kb=$MEM_AVAILABLE cooldown_until=$COOLDOWN_UNTIL; configuration may inherently require this memory or another component may be responsible"
	write_status
}

run_recovery_action_locked() {
	action="$1"
	before_rss="$CURRENT_RSS"
	LAST_ACTION="$action"
	LAST_RESULT="running"
	PHASE="recovering"
	write_status
	guard_log "action=$action before_rss_kb=$before_rss mem_available_kb=$MEM_AVAILABLE reserve_kb=$RESERVE psi_full_avg10=$PSI_FULL_AVG10"

	if [ "$action" = "restart" ]; then
		output="$(MICLASH_MEMORY_GUARD_ACTION=1 "$SERVICE_BIN" "$action" 2>&1)"
	else
		output="$("$SERVICE_BIN" "$action" 2>&1)"
	fi
	code="$?"
	if [ "$code" -eq "$ACTION_BUSY_EXIT" ]; then
		LAST_RESULT="service_busy"
		guard_log "action=$action deferred because another MiClash service operation is active"
		write_status
		return "$ACTION_BUSY_EXIT"
	fi
	if [ "$code" -ne 0 ]; then
		LAST_RESULT="action_failed"
		guard_log "action=$action failed: $output"
		write_status
		return 2
	fi

	sleep 60
	if ! refresh_measurements; then
		LAST_RESULT="measurement_failed"
		guard_log "action=$action completed but post-action measurements are unavailable"
		write_status
		return 2
	fi

	guard_log "action=$action after_rss_kb=$CURRENT_RSS mem_available_kb=$MEM_AVAILABLE psi_full_avg10=$PSI_FULL_AVG10"
	if memory_decreased "$before_rss" "$CURRENT_RSS"; then
		finish_recovery_success "$action"
		return 0
	fi
	LAST_RESULT="no_material_drop"
	write_status
	return 1
}

run_recovery_action() {
	miclash_writer_lock_enter || return $?
	run_recovery_action_locked "$@"
	result=$?
	miclash_writer_lock_leave || return 1
	return "$result"
}

run_full_restart_once() {
	[ "$FULL_RESTART_ATTEMPTED" -eq 0 ] || return 1
	FULL_RESTART_ATTEMPTED=1
	run_recovery_action restart
}

defer_busy_recovery() {
	PHASE="recovery_deferred"
	LAST_RESULT="service_busy"
	PRESSURE_COUNT=0
	guard_log "recovery cycle deferred because another MiClash service operation is active"
	write_status
	return 1
}

recover_memory() {
	FULL_RESTART_ATTEMPTED=0
	run_recovery_action guard-reload && return 0
	reload_result="$?"
	if [ "$reload_result" -eq "$ACTION_BUSY_EXIT" ]; then
		defer_busy_recovery
		return 1
	fi

	run_recovery_action guard-core-restart && return 0
	core_result="$?"
	if [ "$core_result" -eq "$ACTION_BUSY_EXIT" ]; then
		defer_busy_recovery
		return 1
	fi

	run_full_restart_once
	full_result="$?"
	[ "$full_result" -eq 0 ] && return 0
	if [ "$full_result" -eq "$ACTION_BUSY_EXIT" ]; then
		defer_busy_recovery
		return 1
	fi
	finish_recovery_failure "reload=$reload_result core_restart=$core_result full_restart=$full_result"
	return 1
}

run_monitor() {
	[ ! -e "$PACKAGE_REMOVAL_BARRIER" ] || return 0
	mkdir -p "$STATE_DIR" 2>/dev/null || exit 1
	load_runtime_state
	LAST_MANUAL_OPERATION="$(read_manual_operation)"
	guard_log "monitor started"
	while setting_enabled; do
		[ ! -e "$PACKAGE_REMOVAL_BARRIER" ] || return 0
		pid="$(find_mihomo_pid)"
		if [ -z "$pid" ] || [ ! -r "$PROC_ROOT/$pid/status" ]; then
			PHASE="waiting_for_mihomo"
			TRACKED_PID=""
			write_status
			sleep "$SAMPLE_INTERVAL_SEC"
			continue
		fi

		starttime="$(read_process_starttime "$pid")"
		if [ "$pid" != "$TRACKED_PID" ] || [ "$starttime" != "$TRACKED_STARTTIME" ]; then
			reset_baseline "$pid"
		fi

		CURRENT_RSS="$(read_mihomo_rss_kb "$pid")"
		case "$CURRENT_RSS" in ''|*[!0-9]*) sleep "$SAMPLE_INTERVAL_SEC"; continue ;; esac
		if ! read_memory_metrics; then
			PHASE="metrics_unavailable"
			write_status
			sleep "$SAMPLE_INTERVAL_SEC"
			continue
		fi
		read_memory_psi
		detect_manual_operation || true

		now="$(now_sec)"
		if [ "$BASELINE_RSS" -eq 0 ]; then
			if [ $((now - BASELINE_STARTED_AT)) -ge "$WARMUP_SEC" ]; then
				PHASE="learning_baseline"
				collect_baseline_sample || true
			fi
		elif cooldown_active; then
			PHASE="cooldown"
		elif ! failure_rearm_ready; then
			PHASE="failure_rearm_wait"
		else
			PHASE="monitoring"
			observe_pressure
			if [ "$PRESSURE_COUNT" -ge "$PRESSURE_SAMPLES_REQUIRED" ]; then
				handle_recovery_trigger
				PRESSURE_COUNT=0
			fi
		fi

		write_status
		sleep "$SAMPLE_INTERVAL_SEC"
	done
	PHASE="disabled"
	write_status
	guard_log "monitor stopped because the setting is disabled"
}

sync_guard_service_locked() {
	[ ! -e "$PACKAGE_REMOVAL_BARRIER" ] || return "$ACTION_BUSY_EXIT"
	if setting_enabled; then
		"$SERVICE_INIT" enable >/dev/null 2>&1 || return 1
		"$SERVICE_INIT" running >/dev/null 2>&1 || "$SERVICE_INIT" start >/dev/null 2>&1 || return 1
		guard_log "service enabled and started"
	else
		"$SERVICE_INIT" stop >/dev/null 2>&1 || true
		"$SERVICE_INIT" disable >/dev/null 2>&1 || return 1
		guard_log "service stopped and disabled"
	fi
}

sync_guard_service() {
	miclash_writer_lock_enter || return $?
	sync_guard_service_locked
	result=$?
	miclash_writer_lock_leave || return 1
	return "$result"
}

case "${1:-}" in
	reserve)
		[ "$#" -eq 2 ] || exit 2
		calc_reserve_kb "$2"
		;;
	anomaly)
		[ "$#" -eq 3 ] || exit 2
		is_anomaly "$2" "$3"
		;;
	decreased)
		[ "$#" -eq 3 ] || exit 2
		memory_decreased "$2" "$3"
		;;
	median)
		[ "$#" -eq 7 ] || exit 2
		shift
		median_six "$@"
		;;
	snapshot)
		[ "$#" -eq 1 ] || exit 2
		print_snapshot
		;;
	run)
		[ "$#" -eq 1 ] || exit 2
		run_monitor
		;;
	sync)
		[ "$#" -eq 1 ] || exit 2
		sync_guard_service
		;;
	*)
		echo "usage: $0 reserve MEMTOTAL_KB | anomaly BASELINE_KB RSS_KB | decreased BEFORE_KB AFTER_KB | median N1 N2 N3 N4 N5 N6 | snapshot | run | sync" >&2
		exit 2
		;;
esac
