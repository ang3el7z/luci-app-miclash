#!/bin/sh

set -u

PACKAGE_REMOVAL_BARRIER="/var/run/miclash/package-removal"

SETTINGS_FILE="/opt/clash/settings"
SERVICE_BIN="/opt/clash/bin/miclash-service"
SUBSCRIPTION_BIN="/opt/clash/bin/miclash-subscription"
STATE_DIR="/tmp/miclash-autoupdate"
LAST_SUCCESS_FILE="$STATE_DIR/last_success"
LAST_ATTEMPT_FILE="$STATE_DIR/last_attempt"
LOCK_DIR="/tmp/miclash-autoupdate.lock"
POLL_INTERVAL_SEC=60
DEFAULT_INTERVAL_HOURS="4"
LOCK_ACQUIRED=0
MUTATION_LOCK_HELD=0
MUTATION_LOCK_HELPER="/usr/share/miclash/mutation-lock.sh"
[ -r "$MUTATION_LOCK_HELPER" ] || { echo 'MiClash mutation lock unavailable' >&2; exit 1; }
. "$MUTATION_LOCK_HELPER" || exit 1

miclash_writer_lock_enter() {
	miclash_mutation_lock_enter normal 30000 || return $?
	MUTATION_LOCK_HELD=1
}

miclash_writer_lock_leave() {
	[ "$MUTATION_LOCK_HELD" = 1 ] || return 0
	miclash_mutation_lock_leave || return 1
	MUTATION_LOCK_HELD=0
}

cleanup() {
	release_lock
	miclash_writer_lock_leave >/dev/null 2>&1 || true
}

release_lock() {
	if [ "$LOCK_ACQUIRED" = "1" ]; then
		rm -rf "$LOCK_DIR" 2>/dev/null || true
		LOCK_ACQUIRED=0
	fi
}

trap cleanup EXIT INT TERM

log_info() {
	logger -p daemon.info -t miclash-autoupdate "$*" 2>/dev/null || true
}

log_warn() {
	logger -p daemon.warn -t miclash-autoupdate "$*" 2>/dev/null || true
}

now_sec() {
	date +%s 2>/dev/null || echo 0
}

setting_value() {
	key="$1"
	fallback="${2:-}"
	value=""

	if [ -f "$SETTINGS_FILE" ]; then
		value="$(sed -n "s/^${key}=//p" "$SETTINGS_FILE" 2>/dev/null | tail -n 1)"
	fi

	if [ -n "$value" ]; then
		printf '%s' "$value"
	else
		printf '%s' "$fallback"
	fi
}

set_setting_value() {
	key="$1"
	value="$2"
	tmp="$SETTINGS_FILE.tmp.$$"

	mkdir -p "$(dirname "$SETTINGS_FILE")" 2>/dev/null || true
	if [ -f "$SETTINGS_FILE" ]; then
		awk -v key="$key" -v value="$value" '
			BEGIN { done = 0 }
			index($0, key "=") == 1 { print key "=" value; done = 1; next }
			{ print }
			END { if (!done) print key "=" value }
		' "$SETTINGS_FILE" > "$tmp" && mv "$tmp" "$SETTINGS_FILE"
	else
		printf '%s=%s\n' "$key" "$value" > "$tmp" && mv "$tmp" "$SETTINGS_FILE"
	fi
	chmod 0644 "$SETTINGS_FILE" 2>/dev/null || true
}

normalize_interval_hours() {
	hours="$(printf '%s' "${1:-}" | tr -d '[:space:]')"
	case "$hours" in
		*[!0-9]*|0|"") printf '%s' "$DEFAULT_INTERVAL_HOURS" ;;
		*) printf '%s' "$hours" ;;
	esac
}

interval_seconds() {
	hours="$(normalize_interval_hours "$(setting_value AUTO_UPDATE_INTERVAL_HOURS "$DEFAULT_INTERVAL_HOURS")")"
	echo $((hours * 3600))
}

auto_update_enabled() {
	[ "$(setting_value AUTO_UPDATE_CONFIG true)" != "false" ]
}

is_due() {
	[ -f "$LAST_ATTEMPT_FILE" ] || return 0
	last="$(cat "$LAST_ATTEMPT_FILE" 2>/dev/null || echo 0)"
	case "$last" in
		''|*[!0-9]*) return 0 ;;
	esac

	[ $(( $(now_sec) - last )) -ge "$(interval_seconds)" ]
}

is_service_running() {
	if command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
		if ubus call service list '{"name":"clash"}' 2>/dev/null |
			jsonfilter -e '@.clash.instances.*.running' 2>/dev/null |
			grep -q true; then
			return 0
		fi
	fi

	pidof clash >/dev/null 2>&1
}

acquire_lock() {
	if mkdir "$LOCK_DIR" 2>/dev/null; then
		LOCK_ACQUIRED=1
		printf '%s\n' "$$" > "$LOCK_DIR/pid"
		return 0
	fi

	old_pid=""
	[ -f "$LOCK_DIR/pid" ] && old_pid="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
	if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
		log_info "another auto-update is already running (pid $old_pid)"
		return 1
	fi

	rm -rf "$LOCK_DIR" 2>/dev/null || true
	mkdir "$LOCK_DIR" 2>/dev/null || return 1
	LOCK_ACQUIRED=1
	printf '%s\n' "$$" > "$LOCK_DIR/pid"
}

run_once_locked() {
	[ ! -e "$PACKAGE_REMOVAL_BARRIER" ] || return 75
	auto_update_enabled || return 0
	acquire_lock || return 0
	mkdir -p "$STATE_DIR" 2>/dev/null || {
		release_lock
		return 1
	}
	printf '%s\n' "$(now_sec)" > "$LAST_ATTEMPT_FILE"

	result="$("$SUBSCRIPTION_BIN" apply-saved-main 2>&1)" || {
		log_warn "Main subscription update failed: $(printf '%s' "$result" | tr '\r\n' '  ')"
		release_lock
		return 1
	}

	hours="$(printf '%s\n' "$result" | sed -n 's/^profileUpdateIntervalHours=//p' | tail -n 1)"
	case "$hours" in
		''|*[!0-9]*|0) ;;
		*) set_setting_value AUTO_UPDATE_INTERVAL_HOURS "$hours" ;;
	esac

	if is_service_running; then
		if "$SERVICE_BIN" reload >/dev/null 2>&1; then
			log_info "Main config updated and Mihomo configuration reloaded"
		else
			log_warn "Main config updated, but Mihomo hot reload failed"
		fi
	else
		log_info "Main config updated; service is stopped, reload skipped"
	fi

	printf '%s\n' "$(now_sec)" > "$LAST_SUCCESS_FILE"
	release_lock
}

run_once() {
	miclash_writer_lock_enter || return $?
	run_once_locked
	result=$?
	miclash_writer_lock_leave || return 1
	return "$result"
}

run_loop() {
	mkdir -p "$STATE_DIR" 2>/dev/null || true
	while true; do
		[ ! -e "$PACKAGE_REMOVAL_BARRIER" ] || return 0
		if auto_update_enabled && is_due; then
			run_once || true
		fi
		sleep "$POLL_INTERVAL_SEC"
	done
}

case "${1:-run}" in
	run)
		run_loop
		;;
	once)
		run_once
		;;
	*)
		echo "Usage: $0 {run|once}" >&2
		exit 1
		;;
esac
