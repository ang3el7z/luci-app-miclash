#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1
PACKAGE_REMOVAL_BARRIER="/var/run/miclash/package-removal"
APP_UPDATE_MARKER="/tmp/miclash-package-no-autostart-autoupdate"

app_update_handoff_active() {
	[ ! -L "$APP_UPDATE_MARKER" ] && [ -f "$APP_UPDATE_MARKER" ] || return 1
	[ "$(stat -c '%u:%a:%h' "$APP_UPDATE_MARKER" 2>/dev/null)" = '0:600:1' ] || return 1
	[ "$(readlink -f "$APP_UPDATE_MARKER" 2>/dev/null)" = "$APP_UPDATE_MARKER" ] || return 1
	[ "$(wc -l < "$APP_UPDATE_MARKER" 2>/dev/null | tr -d '[:space:]')" = 1 ] || return 1
	status_file="$(cat "$APP_UPDATE_MARKER" 2>/dev/null)" || return 1
	case "$status_file" in
		/tmp/miclash/updates/handoff-*.status) ;;
		*) return 1 ;;
	esac
	[ ! -L "$status_file" ] && [ -f "$status_file" ] || return 1
	[ "$(stat -c '%u:%a:%h' "$status_file" 2>/dev/null)" = '0:600:1' ] || return 1
	[ "$(readlink -f "$status_file" 2>/dev/null)" = "$status_file" ] || return 1
	operation_id="${status_file##*/handoff-}"
	operation_id="${operation_id%.status}"
	printf '%s\n' "$operation_id" |
		grep -Eq '^[0-9]{13}-[0-9]{8}-[0-9a-f]{16}$' || return 1
	operation_journal="/tmp/miclash/operations/$operation_id.json"
	[ ! -L "$operation_journal" ] && [ -f "$operation_journal" ] || return 1
	[ "$(stat -c '%u:%a:%h' "$operation_journal" 2>/dev/null)" = '0:600:1' ] || return 1
	[ "$(readlink -f "$operation_journal" 2>/dev/null)" = "$operation_journal" ] || return 1
	grep -Eq '"state"[[:space:]]*:[[:space:]]*"(queued|running)"' \
		"$operation_journal" || return 1
	[ "$(ubus call service list '{"name":"miclashd"}' 2>/dev/null |
		jsonfilter -e '@.miclashd.instances.instance1.running' 2>/dev/null)" = true ]
}

# OpenWrt's default_prerm stops every packaged init service even on upgrades.
# default_postinst starts it again. Keep the live operation owner unchanged
# across both calls; the installer performs one deferred terminal reload.
case "${action:-}" in
	start|stop)
		app_update_handoff_active && USE_PROCD=
		;;
esac

start_service() {
	[ ! -e "$PACKAGE_REMOVAL_BARRIER" ] || return 1
	procd_open_instance
	procd_set_param command /usr/bin/ucode -L '/usr/share/*.uc' /usr/sbin/miclashd
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance telegram-poller
	procd_set_param command /usr/bin/ucode -L '/usr/share/*.uc' /usr/sbin/miclash-telegram-poller
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance upgrade-recover
	procd_set_param command /usr/share/miclash/package-upgrade-recover /etc/miclash/package-upgrade-state
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
