#!/bin/sh /etc/rc.common

START=94
STOP=11
USE_PROCD=1

PACKAGE_REMOVAL_BARRIER="/var/run/miclash/package-removal"
CORE="/opt/clash/bin/clash"
CONFIG_DIR="/opt/clash"

start_service() {
	[ ! -e "$PACKAGE_REMOVAL_BARRIER" ] || {
		logger -t miclash -p daemon.err "mihomo: start blocked reason=package-removal"
		return 1
	}
	[ -x "$CORE" ] || {
		logger -t miclash -p daemon.err "mihomo: start blocked reason=missing-kernel"
		return 1
	}
	[ -f "$CONFIG_DIR/config.yaml" ] || {
		logger -t miclash -p daemon.err "mihomo: start blocked reason=missing-config"
		return 1
	}
	# Do not let Mihomo become reachable until the independent early-boot
	# owner has applied and exactly verified the effective Guard/latch policy.
	# Re-running the idempotent transaction here also closes the rc.common
	# failure boundary: a failed START=12 service cannot be bypassed by START=94.
	[ -x /etc/init.d/miclash-guard ] || {
		logger -t miclash -p daemon.err "mihomo: start blocked reason=missing-guard-gate"
		return 1
	}
	/etc/init.d/miclash-guard start || {
		logger -t miclash -p daemon.err "mihomo: start blocked reason=guard-gate-failed"
		return 1
	}
	logger -t miclash -p daemon.info "mihomo: starting under procd"

	procd_open_instance
	procd_set_param command /opt/clash/bin/clash -d /opt/clash -f /opt/clash/config.yaml
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0"
	procd_close_instance
}
