#!/bin/sh /etc/rc.common

START=21
STOP=79
USE_PROCD=1

CLASH_DIR="/opt/clash"
CLASH_BIN="${CLASH_DIR}/bin/clash"
CLASH_RULES="${CLASH_DIR}/bin/clash-rules"
RULESET_TMPFS="/tmp/clash/ruleset"
RULESET_LINK="${CLASH_DIR}/ruleset"
PROXY_PROVIDERS_TMPFS="/tmp/clash/proxy_providers"
PROXY_PROVIDERS_LINK="${CLASH_DIR}/proxy_providers"
DNS_CONTROL="/usr/share/miclash/dns-control.uc"
CONFIG_UPGRADE_BACKUP="${CLASH_DIR}/.config.yaml.upgrade.bak"
SETTINGS_FILE="${CLASH_DIR}/settings"
USE_TMPFS_RULES="true"
PACKAGE_REMOVAL_BARRIER="/var/run/miclash/package-removal"
MUTATION_LOCK_HELD=0
[ -r /usr/share/miclash/mutation-lock.sh ] || return 1
. /usr/share/miclash/mutation-lock.sh || return 1

miclash_writer_lock_enter() {
	local mode="normal"
	[ "${MICLASH_MUTATION_LOCK_PACKAGE:-0}" != "1" ] || mode="package"
	miclash_mutation_lock_enter "$mode" 30000 || return $?
	MUTATION_LOCK_HELD=1
}

miclash_writer_lock_leave() {
	[ "$MUTATION_LOCK_HELD" = "1" ] || return 0
	miclash_mutation_lock_leave || return 1
	MUTATION_LOCK_HELD=0
}

miclash_writer_call() {
	miclash_writer_lock_enter || return $?
	"$@"
	local result=$?
	miclash_writer_lock_leave || return 1
	return "$result"
}

package_removal_active() {
	[ -e "$PACKAGE_REMOVAL_BARRIER" ] || [ -L "$PACKAGE_REMOVAL_BARRIER" ]
}

if [ -f "$SETTINGS_FILE" ]; then
	tmpfs_val="$(grep -m1 '^USE_TMPFS_RULES=' "$SETTINGS_FILE" 2>/dev/null | cut -d'=' -f2)"
	[ "$tmpfs_val" = "false" ] && USE_TMPFS_RULES="false"
fi

# Function to log messages
msg() {
	logger -p daemon.info -st "clash[$$]" "$*"
}

# Function to check the existence of files/directories
check_files() {
	if [ ! -f "$CLASH_BIN" ]; then
		msg "ERROR: Clash binary not found at $CLASH_BIN"
		return 1
	fi

	if [ ! -f "$CLASH_RULES" ]; then
		msg "WARNING: Clash rules script not found at $CLASH_RULES"
	fi

	return 0
}

restore_upgrade_config_backup() {
	if [ -f "$CONFIG_UPGRADE_BACKUP" ]; then
		if mv "$CONFIG_UPGRADE_BACKUP" "$CLASH_DIR/config.yaml"; then
			msg "Restored preserved config.yaml from package upgrade backup"
		else
			msg "ERROR: Failed to restore preserved config.yaml from package upgrade backup"
			return 1
		fi
	fi

	return 0
}

ensure_top_level_config_key() {
	local key="$1"
	local line="$2"
	local tmp_file="${CLASH_DIR}/.${key}.tmp.$$"

	[ -f "$CLASH_DIR/config.yaml" ] || return 0
	grep -Eq "^[[:space:]]*${key}:" "$CLASH_DIR/config.yaml" && return 0

	awk -v insert_line="$line" '
		BEGIN { inserted = 0 }
		{
			print
			if (!inserted && $0 ~ /^mode:[[:space:]]*/) {
				print insert_line
				inserted = 1
			}
		}
		END {
			if (!inserted) print insert_line
		}
	' "$CLASH_DIR/config.yaml" > "$tmp_file" && mv "$tmp_file" "$CLASH_DIR/config.yaml"
}

ensure_transparent_proxy_ports() {
	local proxy_mode="tproxy"

	[ -f "$SETTINGS_FILE" ] && proxy_mode=$(grep -m1 '^PROXY_MODE=' "$SETTINGS_FILE" 2>/dev/null | cut -d= -f2 | tr -d '[:space:]')
	case "$proxy_mode" in
		tproxy|mixed) ;;
		*) return 0 ;;
	esac

	ensure_top_level_config_key "redir-port" "redir-port: 7892" || return 1
	ensure_top_level_config_key "tproxy-port" "tproxy-port: 7894" || return 1
}

# Function to set up clash directories
setup_clash_directories() {
	if [ "$USE_TMPFS_RULES" = "true" ]; then
		# Setup ruleset in tmpfs with symlink from CLASH_DIR
		if [ ! -d "$RULESET_TMPFS" ]; then
			if ! mkdir -p "$RULESET_TMPFS"; then
				msg "ERROR: Failed to create directory $RULESET_TMPFS"
				return 1
			fi
			msg "Created directory '$RULESET_TMPFS'"
		fi

		if [ ! -L "$RULESET_LINK" ] || [ "$(readlink "$RULESET_LINK")" != "$RULESET_TMPFS" ]; then
			rm -rf "$RULESET_LINK"
			if ! ln -s "$RULESET_TMPFS" "$RULESET_LINK"; then
				msg "ERROR: Failed to create symlink from '$RULESET_TMPFS' to '$RULESET_LINK'"
				return 1
			fi
			msg "Created symlink from '$RULESET_TMPFS' to '$RULESET_LINK'"
		fi

		# Setup proxy_providers in tmpfs with symlink from CLASH_DIR
		if [ ! -d "$PROXY_PROVIDERS_TMPFS" ]; then
			if ! mkdir -p "$PROXY_PROVIDERS_TMPFS"; then
				msg "ERROR: Failed to create directory $PROXY_PROVIDERS_TMPFS"
				return 1
			fi
			msg "Created directory '$PROXY_PROVIDERS_TMPFS'"
		fi

		if [ ! -L "$PROXY_PROVIDERS_LINK" ] || [ "$(readlink "$PROXY_PROVIDERS_LINK")" != "$PROXY_PROVIDERS_TMPFS" ]; then
			rm -rf "$PROXY_PROVIDERS_LINK"
			if ! ln -s "$PROXY_PROVIDERS_TMPFS" "$PROXY_PROVIDERS_LINK"; then
				msg "ERROR: Failed to create symlink from '$PROXY_PROVIDERS_TMPFS' to '$PROXY_PROVIDERS_LINK'"
				return 1
			fi
			msg "Created symlink from '$PROXY_PROVIDERS_TMPFS' to '$PROXY_PROVIDERS_LINK'"
		fi
	else
		# Use persistent storage under CLASH_DIR without tmpfs or symlinks
		if [ -L "$RULESET_LINK" ]; then
			rm -f "$RULESET_LINK"
		fi
		if [ ! -d "$RULESET_LINK" ]; then
			if ! mkdir -p "$RULESET_LINK"; then
				msg "ERROR: Failed to create persistent ruleset directory $RULESET_LINK"
				return 1
			fi
			msg "Created persistent ruleset directory '$RULESET_LINK'"
		fi

		if [ -L "$PROXY_PROVIDERS_LINK" ]; then
			rm -f "$PROXY_PROVIDERS_LINK"
		fi
		if [ ! -d "$PROXY_PROVIDERS_LINK" ]; then
			if ! mkdir -p "$PROXY_PROVIDERS_LINK"; then
				msg "ERROR: Failed to create persistent proxy_providers directory $PROXY_PROVIDERS_LINK"
				return 1
			fi
			msg "Created persistent proxy_providers directory '$PROXY_PROVIDERS_LINK'"
		fi
	fi

	return 0
}

dns_control() {
	[ -f "$DNS_CONTROL" ] && command -v ucode >/dev/null 2>&1 || return 1
	ucode -L '/usr/share/*.uc' "$DNS_CONTROL" "$1" >/dev/null 2>&1
}

# Function to apply firewall rules
apply_firewall_rules() {
	package_removal_active && return 1
	if [ -f "$CLASH_RULES" ]; then
		if "$CLASH_RULES" start; then
			msg "Firewall rules applied"
			return 0
		else
			msg "ERROR: Failed to apply firewall rules"
			return 1
		fi
	else
		msg "WARNING: Clash rules script not found, skipping firewall configuration"
		return 0
	fi
}

# Function to remove firewall rules
remove_firewall_rules() {
	local preserve="${1:-false}"
	if [ -f "$CLASH_RULES" ]; then
		if { [ "$preserve" = true ] && "$CLASH_RULES" package_cleanup; } || \
		   { [ "$preserve" != true ] && "$CLASH_RULES" stop; }; then
			msg "Firewall rules removed"
		else
			msg "ERROR: Failed to remove firewall rules"
			return 1
		fi
	fi
	return 0
}

refresh_guard_rules() {
	if [ -f "$CLASH_RULES" ]; then
		if "$CLASH_RULES" guard_refresh; then
			msg "Client forwarding guard refreshed"
		else
			msg "WARNING: Failed to refresh client forwarding guard"
		fi
	fi
}

start_service_locked() {
	if package_removal_active; then
		msg "Package removal barrier active; refusing Clash start"
		return 1
	fi
	if [ -f /tmp/miclash-package-no-autostart-clash ]; then
		rm -f /tmp/miclash-package-no-autostart-clash
		/etc/init.d/clash disable >/dev/null 2>&1 || true
		return 0
	fi

	msg "Starting Clash service..."

	# Apply or remove the fail-closed guard before any expensive startup work.
	refresh_guard_rules
	restore_upgrade_config_backup || return 1

	# Check the required files
	check_files || return 1

	# Set up the directories (ruleset and proxy_providers)
	setup_clash_directories || return 1

	# Make sure transparent inbounds required by firewall rules exist even when
	# a subscription overwrote config.yaml without MiClash-managed ports.
	ensure_transparent_proxy_ports || {
		msg "ERROR: Failed to ensure transparent proxy ports in config.yaml"
		return 1
	}

	# Check Clash configuration
	if ! "$CLASH_BIN" -d "$CLASH_DIR" -t; then
		msg "ERROR: Clash configuration test failed"
		return 1
	fi

	# Apply firewall rules — failure is fatal: without redirect rules traffic
	# bypasses the proxy entirely, which makes the DNS-to-Clash setup incoherent.
	apply_firewall_rules || {
		msg "ERROR: Failed to apply firewall rules, aborting start"
		return 1
	}

	# Set up DNS — on failure, roll back the firewall rules we just applied.
	dns_control apply || {
		msg "ERROR: Failed to configure DNS, rolling back firewall rules"
		remove_firewall_rules
		return 1
	}

	# Start Clash via procd
	procd_open_instance
	procd_set_param command "$CLASH_BIN" -d "$CLASH_DIR"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param file "$CLASH_DIR/config.yaml"
	procd_close_instance

	msg "Clash service started successfully"
}

stop_service_locked() {
	msg "Stopping Clash service..."
	local preserve=false
	package_removal_active && preserve=true

	# Remove firewall rules
	remove_firewall_rules "$preserve" || return 1

	# Keep the client forwarding guard active only when enabled.
	[ "$preserve" = true ] || refresh_guard_rules || return 1

	# Restore DNS settings
	dns_control cleanup || return 1

	msg "Clash service stopped"
}

reload_service_locked() {
	package_removal_active && return 1
	msg "Reloading Clash service..."

	stop
	start

	msg "Clash service reloaded"
}

# Called by package manager during removal (`/etc/init.d/clash delete`).
# Make it idempotent: service may already be gone, so ignore "Not found".
delete_locked() {
	ubus call service delete '{ "name": "clash" }' >/dev/null 2>&1 && return 0
	ubus call service list '{ "name": "clash" }' 2>/dev/null | grep -q '"clash"' && return 1
	return 0
}

package_cleanup_locked() {
	package_removal_active || return 1
	remove_firewall_rules true || return 1
	return 0
}

service_started_locked() {
	package_removal_active && return 0
	# Called by procd every time the service process (re)starts, including respawns.
	# The package-installed /etc/hotplug.d/net/99-clash-tun handles the normal
	# case: when mihomo creates clash-tun, the kernel event fires the hotplug script
	# which calls `clash-rules tun_route_setup`.
	# tun_route_watch covers the fast-respawn edge case where clash-tun is still up
	# when procd fires this callback (interface did not disappear between respawns).
	local proxy_mode=""
	[ -f "$SETTINGS_FILE" ] && proxy_mode=$(grep '^PROXY_MODE=' "$SETTINGS_FILE" | cut -d= -f2 | tr -d '[:space:]')
	case "$proxy_mode" in
		mixed|tun)
			if [ -f "$CLASH_RULES" ]; then
				"$CLASH_RULES" tun_route_watch
				local i=0
				while [ "$i" -lt 30 ]; do
					[ -d /sys/class/net/clash-tun ] && break
					sleep 1
					i=$((i + 1))
				done
				"$CLASH_RULES" tun_route_setup
				"$CLASH_RULES" repair_policy
				"$CLASH_RULES" repair_forward_rules
			fi
			;;
	esac
}

start_service() { miclash_writer_call start_service_locked "$@"; }
stop_service() { miclash_writer_call stop_service_locked "$@"; }
reload_service() { miclash_writer_call reload_service_locked "$@"; }
delete() { miclash_writer_call delete_locked "$@"; }
package_cleanup() { miclash_writer_call package_cleanup_locked "$@"; }
service_started() { miclash_writer_call service_started_locked "$@"; }

service_triggers() {
	procd_add_reload_trigger "clash"
}

boot_deps_ready() {
	[ -n "$(pidof dnsmasq 2>/dev/null)" ] &&
		ip route show default 2>/dev/null | grep -q '^default'
}

wait_for_boot_deps() {
	local max=10
	local dnsmasq_only=5
	local i=0

	while [ "$i" -lt "$max" ]; do
		if boot_deps_ready; then
			[ "$i" -gt 0 ] && msg "Boot dependencies ready after ${i}s"
			return 0
		fi

		# dnsmasq is required for our DNS redirect path; default route is
		# best-effort (clash-rules skips subscription DNS without it and the
		# WAN-up hotplug refreshes later). Don't block the full 10s waiting
		# for a route that may never appear (e.g. AP / offline boot).
		if [ "$i" -ge "$dnsmasq_only" ] && [ -n "$(pidof dnsmasq 2>/dev/null)" ]; then
			msg "dnsmasq ready after ${i}s (no default route yet; WAN-up hook will refresh)"
			return 0
		fi

		sleep 1
		i=$((i + 1))
	done

	msg "Boot wait timed out after ${max}s, starting anyway"
	return 0
}

boot() {
	wait_for_boot_deps
	start
}
