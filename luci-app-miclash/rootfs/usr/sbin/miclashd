#!/usr/bin/ucode

import * as uloop from 'uloop';
import * as runtime from 'miclash.runtime';
import * as daemon from 'miclash.daemon';
import * as daemon_activation from 'miclash.daemon-activation';
import * as daemon_readiness from 'miclash.daemon-readiness';
import * as startup_guard from 'miclash.startup-guard';

if (uloop.init() !== true)
	die('INTERNAL');

let environment = runtime.create();
let readiness = daemon_readiness.create(environment);
readiness.clear();
let process = daemon.compose(environment);
let shutting_down = false;
let aborting = false;
let startup = null;
let observation_timer = null;
let lifecycle = null;

function abort_startup() {
	if (aborting)
		die('INTERNAL');
	aborting = true;
	shutting_down = true;
	try { readiness.revoke(); } catch (readiness_error) {}
	try { lifecycle?.close?.(); } catch (lifecycle_error) {}
	try { startup?.close?.(); } catch (startup_error) {}
	try { process.drain(); } catch (drain_error) {}
	try { process.close(); } catch (close_error) {}
	uloop.done();
	die('INTERNAL');
};

function start_observation() {
	if (shutting_down) return false;
	if (observation_timer != null)
		return true;
	let candidate = uloop.timer(0, () => {
		try { process.state.observe('config.yaml'); }
		catch (error) {}
		if (!shutting_down)
			observation_timer.set(10000);
	});
	if (candidate == null)
		abort_startup();
	observation_timer = candidate;
	return true;
};

lifecycle = daemon_activation.create({
	clock: environment.clock,
	activate: () => readiness.activate(environment.reconcile, 'daemon-startup'),
	observe: start_observation
});

function start_normal_lifecycle() {
	if (shutting_down) return false;
	return lifecycle.start();
};

try {
	startup = startup_guard.create({
		clock: environment.clock,
		guard: environment.guard_control,
		reconcile: environment.reconcile,
		on_ready: start_normal_lifecycle
	});
	startup.start();
}
catch (error) {
	abort_startup();
}

function shutdown() {
	if (shutting_down)
		return;
	shutting_down = true;
	readiness.revoke();
	lifecycle.close();
	process.drain();
	try { observation_timer.cancel(); } catch (timer_error) {}
	try { startup.close(); } catch (startup_error) {}
	try { process.close(); } catch (close_error) {}
	uloop.end();
};

let termination = uloop.signal('SIGTERM', shutdown);
if (termination == null) {
	shutdown();
	uloop.done();
	die('INTERNAL');
}

uloop.run();
shutdown();
try { termination.delete(); } catch (signal_error) {}
uloop.done();
