#!/bin/sh

set -u

RELEASE_DIR="${1:-}"
BARRIER=/var/run/miclash/package-removal
HOLD="$RELEASE_DIR/barrier-complete.hold"
NFT_NAMES='miclash_guard_bootstrap_v1 miclash_guard_emergency_v1 miclash_guard'
IPT_CHAIN=MICLASH_GUARD_FORWARD

valid_proof() {
	path="$1"
	[ ! -L "$path" ] && [ -f "$path" ] || return 1
	[ "$(stat -c '%u:%a' "$path" 2>/dev/null)" = 0:600 ] || return 1
	[ "$(cat "$path" 2>/dev/null)" = complete ]
}

[ "$RELEASE_DIR" = /var/run/miclash/package-removal-release ] || exit 1
[ ! -L "$RELEASE_DIR" ] && [ -d "$RELEASE_DIR" ] || exit 1
[ "$(stat -c '%u:%a' "$RELEASE_DIR" 2>/dev/null)" = 0:700 ] || exit 1
canonical="$(readlink -f "$RELEASE_DIR" 2>/dev/null)" || exit 1
case "$canonical" in
	/var/run/miclash/package-removal-release|/run/miclash/package-removal-release|/tmp/run/miclash/package-removal-release) ;;
	*) exit 1 ;;
esac
valid_proof "$RELEASE_DIR/complete" || exit 1

BARRIER_PRESENT=0
BARRIER_PROOF=none
if [ -e "$BARRIER" ]; then
	[ ! -L "$BARRIER" ] && [ -d "$BARRIER" ] || exit 1
	[ "$(stat -c '%u:%a' "$BARRIER" 2>/dev/null)" = 0:700 ] || exit 1
	BARRIER_PRESENT=1
	if [ -e "$BARRIER/complete" ] || [ -L "$BARRIER/complete" ]; then
		[ ! -e "$HOLD" ] && [ ! -L "$HOLD" ] || exit 1
		valid_proof "$BARRIER/complete" || exit 1
		set -- "$BARRIER"/*
		[ "$#" -eq 1 ] && [ "$1" = "$BARRIER/complete" ] || exit 1
		BARRIER_PROOF=barrier
	else
		valid_proof "$HOLD" || exit 1
		set -- "$BARRIER"/*
		[ "$#" -eq 1 ] && [ ! -e "$1" ] && [ ! -L "$1" ] || exit 1
		BARRIER_PROOF=hold
	fi
else
	[ ! -L "$BARRIER" ] || exit 1
	[ ! -e "$HOLD" ] && [ ! -L "$HOLD" ] || valid_proof "$HOLD" || exit 1
fi

nft_inventory() {
	output="$1"
	owned="$2"
	command -v nft >/dev/null 2>&1 || return 1
	nft list tables > "$output" 2>/dev/null || return 1
	awk '
		BEGIN { bad = 0 }
		$1 == "table" && NF == 3 &&
			($3 == "miclash_guard_bootstrap_v1" ||
			 $3 == "miclash_guard_emergency_v1" || $3 == "miclash_guard") {
			if ($2 != "inet" || seen[$3]++) bad = 1;
			else print $3;
			next;
		}
		/miclash_guard_bootstrap_v1|miclash_guard_emergency_v1|miclash_guard/ { bad = 1 }
		END { exit bad }
	' "$output" > "$owned" || return 1
}

prove_iptables_tools_absent() {
	family="$1"
	case "$family" in
		v4) legacy=/proc/net/ip_tables_names ;;
		v6) legacy=/proc/net/ip6_tables_names ;;
		*) return 1 ;;
	esac
	if [ -e "$legacy" ]; then
		[ ! -L "$legacy" ] && [ -f "$legacy" ] || return 1
		cat "$legacy" > "$RELEASE_DIR/guard-$family.legacy" 2>/dev/null || return 1
		! grep -Fxq filter "$RELEASE_DIR/guard-$family.legacy" || return 1
	else
		# An absent proc inventory means the corresponding legacy kernel
		# tables module is not loaded; a symlink is never accepted as absence.
		[ ! -L "$legacy" ] || return 1
	fi
	command -v nft >/dev/null 2>&1 || return 1
	nft list ruleset > "$RELEASE_DIR/guard-$family.nft-ruleset" 2>/dev/null || return 1
	! grep -Fwq "$IPT_CHAIN" "$RELEASE_DIR/guard-$family.nft-ruleset" || return 1
}

prepare_iptables_family() {
	family="$1"
	save_bin="$2"
	restore_bin="$3"
	before="$RELEASE_DIR/guard-$family.before"
	desired="$RELEASE_DIR/guard-$family.desired"

	if ! command -v "$save_bin" >/dev/null 2>&1 ||
	   ! command -v "$restore_bin" >/dev/null 2>&1; then
		prove_iptables_tools_absent "$family" || return 1
		: > "$RELEASE_DIR/guard-$family.fallback" || return 1
		return 0
	fi
	"$save_bin" -t filter > "$before" 2>/dev/null || return 1
	awk -v chain="$IPT_CHAIN" '
		BEGIN { defs = 0; jumps = 0; rules = 0; tables = 0; commits = 0; bad = 0 }
		$0 == "*filter" { tables++; print; next }
		$0 == "COMMIT" { commits++; print; next }
		index($0, chain) {
			if ($0 ~ ("^:" chain " - \\[[0-9]+:[0-9]+\\]$")) { defs++; next }
			if ($0 == "-A FORWARD -j " chain) { jumps++; next }
			if (index($0, "-A " chain " ") == 1) { rules++; next }
			bad = 1; next
		}
		{ print }
		END {
			if (tables != 1 || commits != 1 || defs > 1 || jumps > 1) bad = 1;
			if (defs == 0 && (jumps != 0 || rules != 0)) bad = 1;
			if (defs == 1 && (jumps != 1 || rules < 1)) bad = 1;
			exit bad;
		}
	' "$before" > "$desired" || return 1
	if grep -Fq "$IPT_CHAIN" "$before"; then
		: > "$RELEASE_DIR/guard-$family.apply" || return 1
	fi
}

apply_iptables_family() {
	family="$1"
	restore_bin="$2"
	save_bin="$3"
	desired="$RELEASE_DIR/guard-$family.desired"
	verified="$RELEASE_DIR/guard-$family.verified"
	[ ! -f "$RELEASE_DIR/guard-$family.fallback" ] || return 0
	[ ! -f "$RELEASE_DIR/guard-$family.apply" ] ||
		"$restore_bin" < "$desired" >/dev/null 2>&1 || return 1
	"$save_bin" -t filter > "$verified" 2>/dev/null || return 1
	! grep -Fq "$IPT_CHAIN" "$verified" || return 1
}

finalize_guard() {
	rm -f "$RELEASE_DIR"/guard-nft.* "$RELEASE_DIR"/guard-v4.* \
		"$RELEASE_DIR"/guard-v6.* || return 1
	nft_inventory "$RELEASE_DIR/guard-nft.before" \
		"$RELEASE_DIR/guard-nft.owned" || return 1
	prepare_iptables_family v4 iptables-save iptables-restore || return 1
	prepare_iptables_family v6 ip6tables-save ip6tables-restore || return 1

	# The nft Guard remains active while both complete filter-table images are
	# restored, so a one-family failure is still fail-closed and retryable.
	apply_iptables_family v4 iptables-restore iptables-save || return 1
	apply_iptables_family v6 ip6tables-restore ip6tables-save || return 1
	if [ -s "$RELEASE_DIR/guard-nft.owned" ]; then
		: > "$RELEASE_DIR/guard-nft.batch" || return 1
		while IFS= read -r name; do
			case " $NFT_NAMES " in *" $name "*) ;; *) return 1 ;; esac
			printf 'delete table inet %s\n' "$name" >> "$RELEASE_DIR/guard-nft.batch" || return 1
		done < "$RELEASE_DIR/guard-nft.owned"
		nft -f "$RELEASE_DIR/guard-nft.batch" >/dev/null 2>&1 || return 1
	fi
}

verify_guard_absent() {
	nft_inventory "$RELEASE_DIR/guard-nft.verified" \
		"$RELEASE_DIR/guard-nft.remaining" || return 1
	[ ! -s "$RELEASE_DIR/guard-nft.remaining" ] || return 1
	for family in v4 v6; do
		case "$family" in
			v4) save_bin=iptables-save; restore_bin=iptables-restore ;;
			v6) save_bin=ip6tables-save; restore_bin=ip6tables-restore ;;
		esac
		if [ -f "$RELEASE_DIR/guard-$family.fallback" ] ||
		   ! command -v "$save_bin" >/dev/null 2>&1 ||
		   ! command -v "$restore_bin" >/dev/null 2>&1; then
			prove_iptables_tools_absent "$family" || return 1
			continue
		fi
		"$save_bin" -t filter > "$RELEASE_DIR/guard-$family.final" 2>/dev/null || return 1
		! grep -Fq "$IPT_CHAIN" "$RELEASE_DIR/guard-$family.final" || return 1
	done
}

cleanup_guard_work() {
	rm -f "$RELEASE_DIR"/guard-nft.* "$RELEASE_DIR"/guard-v4.* \
		"$RELEASE_DIR"/guard-v6.*
}

if [ "$BARRIER_PRESENT" = 0 ]; then
	verify_guard_absent || exit 1
	cleanup_guard_work || exit 1
	exit 0
fi

finalize_guard || exit 1
verify_guard_absent || exit 1
cleanup_guard_work || exit 1
if [ "$BARRIER_PROOF" = barrier ]; then
	mv "$BARRIER/complete" "$HOLD" || exit 1
fi
if ! rmdir "$BARRIER"; then
	exit 1
fi
[ ! -e "$BARRIER" ] || exit 1
# HOLD is the retained inner proof. Postrm removes it together with the outer
# proof only after this helper has reported successful barrier release.
exit 0
