#!/bin/sh

set -eu

state_file="${1:-/etc/miclash/package-upgrade-state}"
[ ! -L "$state_file" ] && [ -f "$state_file" ] || exit 1
[ "$(stat -c '%u:%a:%h' "$state_file" 2>/dev/null)" = '0:600:1' ] || exit 1

guard_enabled="$(sed -n 's/^guard_enabled=\([01]\)$/\1/p' "$state_file")"
service_running="$(sed -n 's/^service_running=\([01]\)$/\1/p' "$state_file")"
case "$guard_enabled" in
	0|1) ;;
	*) exit 1 ;;
esac
case "$service_running" in
	0|1) ;;
	*) exit 1 ;;
esac

[ "$(uci -q get miclash.guard.enabled 2>/dev/null || true)" = "$guard_enabled" ] ||
	exit 1
/etc/init.d/miclash-guard start >/dev/null 2>&1 || exit 1

attempt=0
while [ "$attempt" -lt 30 ]; do
	ubus -t 2 call miclash health '{}' >/dev/null 2>&1 && break
	attempt=$((attempt + 1))
	sleep 1
done

[ "$attempt" -lt 30 ] || exit 1

case "$service_running" in
	1)
		/etc/init.d/clash running >/dev/null 2>&1 ||
			/etc/init.d/clash start >/dev/null 2>&1 || exit 1
		attempt=0
		while [ "$attempt" -lt 30 ]; do
			/etc/init.d/clash running >/dev/null 2>&1 && break
			attempt=$((attempt + 1))
			sleep 1
		done
		[ "$attempt" -lt 30 ] || exit 1
		;;
	0)
		/etc/init.d/clash stop >/dev/null 2>&1 || exit 1
		! /etc/init.d/clash running >/dev/null 2>&1 || exit 1
		;;
esac

rm -f "$state_file" || exit 1
exit 0
