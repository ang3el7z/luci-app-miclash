{
  "schema_version": 1,
  "metadata": {
    "contract": "Canonical outputs describe intended corrected MiClash network semantics, not an unreviewed transcript of legacy side effects.",
    "normalization": "UTF-8, LF, one deterministic command per line, no timestamps, PIDs, counters, handles, or host observations.",
    "rationale": "Named representative scenarios cover each required dimension without a Cartesian product; later compiler tasks compare their normalized output to these files.",
    "corrections": [
      {
        "id": "guard-provider-client-bypass",
        "legacy_observation": "Legacy provider exclusions can permit protected clients to reach a proxy server directly.",
        "intended_semantics": "When Guard is ON, omit client-side proxy-server bypass; retain OUTPUT bypass solely to prevent router-originated proxy loops.",
        "scenarios": [
          "tproxy-explicit-guard-ipv4-quic",
          "mixed-explicit-guard-provider-bypass",
          "tun-explicit-existing-clash-tun"
        ]
      },
      {
        "id": "guard-empty-wan-detection",
        "legacy_observation": "An empty WAN detection result must not be interpreted as permission to forward.",
        "intended_semantics": "When Guard is ON, drop all non-local forwarding for every active address family after local, DHCP, DNAT, and clash-tun exceptions, regardless of WAN discovery or connection state.",
        "scenarios": [
          "tproxy-explicit-empty-detection-guard",
          "tun-exclude-empty-detection-guard"
        ]
      },
      {
        "id": "explicit-empty-interface-set",
        "legacy_observation": "Falling through from an empty explicit interface selection can accidentally proxy unrelated input.",
        "intended_semantics": "An empty explicit selection proxies no client ingress; Guard remains independent and fail-closed.",
        "scenarios": [
          "tproxy-explicit-empty-detection-guard"
        ]
      },
      {
        "id": "existing-clash-tun-route",
        "legacy_observation": "A surviving clash-tun during restart can retain stale or missing policy routes.",
        "intended_semantics": "Reconciliation replaces the owned default route through clash-tun immediately and idempotently.",
        "scenarios": [
          "tun-exclude-open-ipv6-existing",
          "mixed-explicit-guard-provider-bypass",
          "tun-explicit-existing-clash-tun"
        ]
      }
    ]
  },
