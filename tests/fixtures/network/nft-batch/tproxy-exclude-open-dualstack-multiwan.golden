# miclash schema=1 generation=111111111111
add table inet miclash { comment "miclash:schema=1;generation=111111111111"; }
add chain inet miclash prerouting { type filter hook prerouting priority mangle; policy accept; }
add chain inet miclash output { type route hook output priority mangle; policy accept; }
add chain inet miclash tun_input { type filter hook input priority filter; policy accept; }
add chain inet miclash tun_forward { type filter hook forward priority filter; policy accept; }
flush chain inet miclash prerouting
flush chain inet miclash output
flush chain inet miclash tun_input
flush chain inet miclash tun_forward
add chain inet miclash prerouting_g_111111111111
add chain inet miclash output_g_111111111111
add chain inet miclash proxy_g_111111111111
add chain inet miclash tun_input_g_111111111111
add chain inet miclash tun_forward_g_111111111111
add set inet miclash local4_g_111111111111 { type ipv4_addr; flags interval; }
add set inet miclash local6_g_111111111111 { type ipv6_addr; flags interval; }
add set inet miclash proxy_servers4_g_111111111111 { type ipv4_addr; }
add set inet miclash proxy_servers6_g_111111111111 { type ipv6_addr; }
add set inet miclash fakeip_whitelist4_g_111111111111 { type ipv4_addr; flags interval; }
add set inet miclash fakeip_whitelist6_g_111111111111 { type ipv6_addr; flags interval; }
add element inet miclash local4_g_111111111111 { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 }
add element inet miclash local6_g_111111111111 { ::/128, ::1/128, fc00::/7, fe80::/10, ff00::/8 }
add element inet miclash proxy_servers4_g_111111111111 { 1.1.1.1 }
add element inet miclash proxy_servers6_g_111111111111 { 2606:4700:4700::1111 }
add rule inet miclash prerouting_g_111111111111 iifname { "pppoe-wan", "wwan0" } return
add rule inet miclash prerouting_g_111111111111 jump proxy_g_111111111111
add rule inet miclash proxy_g_111111111111 ip daddr @local4_g_111111111111 return
add rule inet miclash proxy_g_111111111111 ip6 daddr @local6_g_111111111111 return
add rule inet miclash proxy_g_111111111111 ip daddr @proxy_servers4_g_111111111111 return
add rule inet miclash proxy_g_111111111111 ip6 daddr @proxy_servers6_g_111111111111 return
add rule inet miclash proxy_g_111111111111 meta nfproto ipv4 meta l4proto tcp tproxy ip to 127.0.0.1:7894 meta mark set 0x1
add rule inet miclash proxy_g_111111111111 meta nfproto ipv6 meta l4proto tcp tproxy ip6 to [::1]:7894 meta mark set 0x1
add rule inet miclash proxy_g_111111111111 meta nfproto ipv4 meta l4proto udp tproxy ip to 127.0.0.1:7894 meta mark set 0x1
add rule inet miclash proxy_g_111111111111 meta nfproto ipv6 meta l4proto udp tproxy ip6 to [::1]:7894 meta mark set 0x1
add rule inet miclash output_g_111111111111 meta mark 0x0002 return
add rule inet miclash output_g_111111111111 meta mark and 0xff00 != 0 return
add rule inet miclash output_g_111111111111 ip daddr @local4_g_111111111111 return
add rule inet miclash output_g_111111111111 ip6 daddr @local6_g_111111111111 return
add rule inet miclash output_g_111111111111 ip daddr @proxy_servers4_g_111111111111 return
add rule inet miclash output_g_111111111111 ip6 daddr @proxy_servers6_g_111111111111 return
add rule inet miclash output_g_111111111111 meta nfproto ipv4 meta mark 0x0 meta l4proto { tcp, udp } meta mark set 0x1
add rule inet miclash output_g_111111111111 meta nfproto ipv6 meta mark 0x0 meta l4proto { tcp, udp } meta mark set 0x1
add rule inet miclash prerouting jump prerouting_g_111111111111
add rule inet miclash output jump output_g_111111111111
delete chain inet miclash prerouting_g_000000000000
delete chain inet miclash output_g_000000000000
delete chain inet miclash tun_input_g_000000000000
delete chain inet miclash tun_forward_g_000000000000
delete chain inet miclash proxy_g_000000000000
delete set inet miclash local4_g_000000000000
delete set inet miclash local6_g_000000000000
delete set inet miclash proxy_servers4_g_000000000000
delete set inet miclash proxy_servers6_g_000000000000
delete set inet miclash fakeip_whitelist4_g_000000000000
delete set inet miclash fakeip_whitelist6_g_000000000000
