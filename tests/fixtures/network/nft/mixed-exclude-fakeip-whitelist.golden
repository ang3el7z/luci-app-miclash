# MiClash intended nft contract v1
add table inet miclash
add set inet miclash local4 { type ipv4_addr; flags interval; }
add element inet miclash local4 { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 }
add set inet miclash local6 { type ipv6_addr; flags interval; }
add element inet miclash local6 { ::/128, ::1/128, fc00::/7, fe80::/10, ff00::/8 }
add chain inet miclash prerouting { type filter hook prerouting priority mangle; policy accept; }
add chain inet miclash proxy
add chain inet miclash output { type route hook output priority mangle; policy accept; }
add set inet miclash fakeip_whitelist4 { type ipv4_addr; flags interval; }
add element inet miclash fakeip_whitelist4 { 198.18.0.0/16, 1.0.0.0/24 }
add rule inet miclash prerouting iifname { "eth1" } return
add rule inet miclash prerouting jump proxy
add rule inet miclash proxy ip daddr @local4 return
add rule inet miclash proxy ip6 daddr @local6 return
add rule inet miclash proxy meta nfproto ipv4 ip daddr @fakeip_whitelist4 meta l4proto tcp tproxy ip to 127.0.0.1:7894 meta mark set 0x1
add rule inet miclash proxy meta nfproto ipv4 ip daddr @fakeip_whitelist4 meta l4proto udp meta mark set 0x3
add rule inet miclash output meta mark 0x0002 return
add rule inet miclash output meta mark and 0xff00 != 0 return
add rule inet miclash output meta nfproto ipv4 meta mark 0x0 meta l4proto tcp meta mark set 0x1
add rule inet miclash output meta nfproto ipv4 meta mark 0x0 meta l4proto udp meta mark set 0x3
add chain inet miclash tun_input { type filter hook input priority filter; policy accept; }
add rule inet miclash tun_input iifname "clash-tun" accept comment "miclash-fwd"
add chain inet miclash tun_forward { type filter hook forward priority filter; policy accept; }
add rule inet miclash tun_forward iifname "clash-tun" accept comment "miclash-fwd"
add rule inet miclash tun_forward oifname "clash-tun" accept comment "miclash-fwd"
