# MiClash intended nft contract v1
add table inet miclash
add set inet miclash local4 { type ipv4_addr; flags interval; }
add element inet miclash local4 { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4, 255.255.255.255/32 }
add set inet miclash local6 { type ipv6_addr; flags interval; }
add element inet miclash local6 { ::/128, ::1/128, fc00::/7, fe80::/10, ff00::/8 }
add chain inet miclash prerouting { type filter hook prerouting priority mangle; policy accept; }
add chain inet miclash proxy
add chain inet miclash output { type route hook output priority mangle; policy accept; }
add table inet miclash_guard
add set inet miclash_guard local4 { type ipv4_addr; flags interval; }
add element inet miclash_guard local4 { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4, 255.255.255.255/32 }
add set inet miclash_guard local6 { type ipv6_addr; flags interval; }
add element inet miclash_guard local6 { ::/128, ::1/128, fc00::/7, fe80::/10, ff00::/8 }
add chain inet miclash_guard forward { type filter hook forward priority 1; policy accept; }
add rule inet miclash_guard forward iifname "clash-tun" accept
add rule inet miclash_guard forward oifname "clash-tun" accept
add rule inet miclash_guard forward ct status dnat accept
add rule inet miclash_guard forward udp sport 67 udp dport 68 accept
add rule inet miclash_guard forward udp sport 68 udp dport 67 accept
add rule inet miclash_guard forward ip daddr @local4 accept
add rule inet miclash_guard forward ip6 daddr @local6 accept
add rule inet miclash_guard forward meta nfproto ipv4 drop comment "miclash-guard"
add rule inet miclash_guard forward meta nfproto ipv6 drop comment "miclash-guard"
add rule inet miclash prerouting iifname { "br-lan", "wlan0" } jump proxy
add rule inet miclash proxy meta nfproto ipv4 ether saddr "02:00:00:00:00:40" drop comment "device-policy:block:quarantined-camera"
add rule inet miclash proxy meta nfproto ipv6 ether saddr "02:00:00:00:00:40" drop comment "device-policy:block:quarantined-camera"
add rule inet miclash proxy meta nfproto ipv4 ether saddr "02:00:00:00:00:41" return comment "device-policy:direct:work-laptop"
add rule inet miclash proxy meta nfproto ipv6 ether saddr "02:00:00:00:00:41" return comment "device-policy:direct:work-laptop"
add rule inet miclash proxy meta nfproto ipv4 ether saddr "02:00:00:00:00:42" meta l4proto tcp tproxy to :7894 meta mark set 0x1
add rule inet miclash proxy meta nfproto ipv4 ether saddr "02:00:00:00:00:42" meta l4proto udp meta mark set 0x3
add rule inet miclash proxy meta nfproto ipv6 ether saddr "02:00:00:00:00:42" meta l4proto tcp tproxy to :7894 meta mark set 0x1
add rule inet miclash proxy meta nfproto ipv6 ether saddr "02:00:00:00:00:42" meta l4proto udp meta mark set 0x3
# device-policy inherit default-phone 02:00:00:00:00:43
add rule inet miclash proxy ip daddr @local4 return
add rule inet miclash proxy ip6 daddr @local6 return
add rule inet miclash proxy meta nfproto ipv4 udp dport 443 reject
add rule inet miclash proxy meta nfproto ipv6 udp dport 443 reject
add rule inet miclash proxy meta nfproto ipv4 meta l4proto tcp tproxy to :7894 meta mark set 0x1
add rule inet miclash proxy meta nfproto ipv6 meta l4proto tcp tproxy to :7894 meta mark set 0x1
add rule inet miclash proxy meta nfproto ipv4 meta l4proto udp meta mark set 0x3
add rule inet miclash proxy meta nfproto ipv6 meta l4proto udp meta mark set 0x3
add rule inet miclash output meta nfproto ipv4 meta l4proto tcp meta mark set 0x1
add rule inet miclash output meta nfproto ipv6 meta l4proto tcp meta mark set 0x1
add rule inet miclash output meta nfproto ipv4 meta l4proto udp meta mark set 0x3
add rule inet miclash output meta nfproto ipv6 meta l4proto udp meta mark set 0x3
add chain inet miclash tun_input { type filter hook input priority filter; policy accept; }
add rule inet miclash tun_input iifname "clash-tun" accept comment "miclash-fwd"
add chain inet miclash tun_forward { type filter hook forward priority filter; policy accept; }
add rule inet miclash tun_forward iifname "clash-tun" accept comment "miclash-fwd"
add rule inet miclash tun_forward oifname "clash-tun" accept comment "miclash-fwd"
